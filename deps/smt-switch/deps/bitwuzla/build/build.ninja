# This is the build file for project "bitwuzla"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule cpp_COMPILER
 command = /home/jiongming/.conda/envs/forward/bin/x86_64-conda-linux-gnu-c++ $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C++ object $out

# Rules for linking.

rule STATIC_LINKER
 command = rm -f $out && /home/jiongming/.conda/envs/forward/bin/x86_64-conda-linux-gnu-ar $LINK_ARGS $out $in
 description = Linking static target $out

rule cpp_LINKER
 command = /home/jiongming/.conda/envs/forward/bin/x86_64-conda-linux-gnu-c++ $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /home/jiongming/.conda/envs/forward/bin/meson --internal regenerate '/home/jiongming/桌面/FORWORD/deps/smt-switch/deps/bitwuzla' .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

