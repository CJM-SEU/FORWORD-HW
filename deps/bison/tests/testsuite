| NUM, or the ASCII character read if not a number.  Skips all   |
| blanks and tabs, returns 0 for EOF.                            |
`---------------------------------------------------------------*/

int yylex (void)
{
  int c;
  /* Skip white spaces.  */
  do
    {

      (yylloc).first.c = (yylloc).last.c;
      (yylloc).first.l   = (yylloc).last.l;

